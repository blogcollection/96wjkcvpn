---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ProductCategoryBar from '../components/ProductCategoryBar.astro';
import CoreFeatures from '../components/CoreFeatures.astro';
import NodeRegions from '../components/NodeRegions.astro';
import AiShowcase from '../components/AiShowcase.astro';
import DeviceSupport from '../components/DeviceSupport.astro';
import Steps from '../components/Steps.astro';
import BigBanner from '../components/BigBanner.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Header />
  <main>
    <Hero />
    <ProductCategoryBar />
    <CoreFeatures />
    <NodeRegions />
    <AiShowcase />
    <DeviceSupport />
    <Steps />
    <BigBanner />
    <FaqSection />
