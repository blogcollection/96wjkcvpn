---
import Logo from './Logo.astro';

const REGISTER_URL = "https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso";

const navLinks = [
  { name: '首页', href: '#hero' },
  { name: '线路优势', href: '#features' },
  { name: '节点分布', href: '#nodes' },
  { name: '支持设备', href: '#devices' },
  { name: '使用教程', href: '#steps' },
  { name: '常见问题', href: '#faq' },
];
---

<header class="fixed top-0 left-0 right-0 z-50 h-[72px] glass-nav border-b border-[#EAEAEA]/80 transition-all duration-300">
  <div class="max-w-[1440px] h-full mx-auto px-6 md:px-10 flex items-center justify-between">
    <!-- Brand Logo -->
    <Logo />

    <!-- Center Nav (Desktop) -->
    <nav class="hidden md:flex items-center gap-8 lg:gap-10">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class="text-[14px] lg:text-[15px] text-[#444444] hover:text-[#111111] font-medium transition-colors duration-200"
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- Right CTAs -->
    <div class="hidden sm:flex items-center gap-4">
      <a 
        href={REGISTER_URL} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="text-[14px] text-[#444444] hover:text-[#111111] font-medium px-3 py-1.5 transition-colors duration-200"
      >
        登录
      </a>
      <a 
        href={REGISTER_URL} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="honor-btn-primary px-5 py-2.5 text-[14px] font-medium tracking-wide shadow-sm"
      >
        立即使用
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <div class="flex items-center gap-3 sm:hidden">
      <a 
        href={REGISTER_URL} 
        target="_blank" 
        rel="noopener noreferrer" 
        class="honor-btn-primary px-3.5 py-1.5 text-[13px] font-medium"
      >
        立即使用
      </a>
      <button 
        id="mobile-menu-toggle" 
        type="button" 
        class="p-2 text-[#111111] rounded-lg hover:bg-[#F5F5F7] transition-colors focus:outline-none"
        aria-label="打开导航菜单"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Drawer -->
  <div 
    id="mobile-menu-drawer" 
    class="hidden sm:hidden border-b border-[#EAEAEA] bg-white/95 backdrop-blur-xl px-6 py-6 transition-all duration-300 shadow-xl"
  >
    <div class="flex flex-col gap-4">
      {navLinks.map(link => (
        <a 
          href={link.href} 
          class="mobile-nav-item text-[16px] text-[#222222] font-medium py-2 border-b border-gray-100 last:border-0"
        >
          {link.name}
        </a>
      ))}
      <div class="pt-4 flex flex-col gap-3">
        <a 
          href={REGISTER_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="w-full text-center honor-btn-primary py-3 text-[15px] font-medium"
        >
          立即使用 / 注册
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');
  const navItems = document.querySelectorAll('.mobile-nav-item');

  if (toggleBtn && drawer && openIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = !drawer.classList.contains('hidden');
      if (isExpanded) {
        drawer.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      } else {
        drawer.classList.remove('hidden');
        openIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
      }
    });

    navItems.forEach(item => {
      item.addEventListener('click', () => {
        drawer.classList.add('hidden');
        openIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
      });
    });
  }
</script>
