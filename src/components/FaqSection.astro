---
const faqs = [
  {
    q: '网际快车是什么？',
    a: '网际快车是面向中文用户的网络连接服务入口，主要用于连接部分海外网络资源与常用网络服务。通过优化线路路由与智能分流，提供稳定且流畅的网络连接体验。',
  },
  {
    q: '支持哪些设备？',
    a: '根据服务端实际配置，可通过 Windows、macOS、iOS、Android 等常见设备使用。支持导入 Clash 系列、Shadowrocket 等主流客户端。',
  },
  {
    q: '可以访问 AI 工具吗？',
    a: '部分线路可用于访问海外 AI 服务（如 ChatGPT、Claude、Gemini 等），但实际可用情况会受到节点、地区及第三方平台政策影响。',
  },
  {
    q: '应该选择哪个节点？',
    a: '一般优先选择距离物理位置较近、延迟较低的节点，例如香港、日本或新加坡。如需访问特定地区资源，可按需切换至对应国家或地区的专线节点。',
  },
  {
    q: '不会配置怎么办？',
    a: '注册后可以在控制台查看详细的图文使用教程，按照对应设备（Windows / Mac / iPhone / Android）步骤导入订阅即可，全过程仅需 1-3 分钟。',
  },
];
---

<section id="faq" class="py-20 md:py-32 bg-[#FAFAFC] border-t border-[#EAEAEA]">
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 lg:px-16">
    
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20">
      <div class="honor-badge mb-4">
        解答与支持
      </div>
      <h2 class="text-[34px] sm:text-[44px] md:text-[50px] font-bold tracking-tight text-[#111111] leading-[1.15]">
        常见问题
      </h2>
      <p class="text-[16px] md:text-[18px] text-[#666666] mt-4">
        为您解答关于网际快车使用、节点选择与设备兼容的疑问。
      </p>
    </div>

    <!-- FAQ Accordion List -->
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((faq, index) => (
        <details 
          class="group bg-white rounded-2xl border border-[#EAEAEF] p-6 transition-all duration-200 open:shadow-subtle open:border-neutral-300"
          {...(index === 0 ? { open: true } : {})}
        >
          <summary class="flex items-center justify-between cursor-pointer list-none select-none text-left">
            <h3 class="text-lg font-bold text-[#111111] group-hover:text-black transition-colors pr-4">
              {faq.q}
            </h3>
            <span class="w-8 h-8 rounded-full bg-[#F5F5F7] group-hover:bg-[#EAEAEA] flex items-center justify-center shrink-0 transition-transform duration-200 group-open:rotate-180">
              <svg class="w-4 h-4 text-[#444444]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-neutral-100 text-[15px] text-[#666666] leading-relaxed">
            <p>{faq.a}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
