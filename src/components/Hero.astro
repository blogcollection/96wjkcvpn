---
const REGISTER_URL = "https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso";
---

<section id="hero" class="relative pt-[100px] md:pt-[120px] pb-16 md:pb-24 overflow-hidden bg-white">
  <!-- Subtle ambient background circle gradient -->
  <div class="absolute top-1/2 right-10 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-to-br from-neutral-100/80 via-neutral-50/40 to-transparent rounded-full blur-3xl pointer-events-none -z-10"></div>
  
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 lg:px-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center min-h-[640px] md:min-h-[720px]">
      
      <!-- Left Column: Content (approx 38% / 5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-center z-10 space-y-6 md:space-y-8 text-left">
        <!-- Small Brand Badge -->
        <div class="inline-flex items-center gap-2 honor-badge self-start">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>网际快车</span>
          <span class="text-neutral-300">|</span>
          <span class="text-neutral-500 font-normal">稳定简单的网络连接服务</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-[44px] sm:text-[54px] md:text-[64px] lg:text-[70px] xl:text-[74px] font-bold tracking-[-0.03em] leading-[1.08] text-[#111111]">
          连接世界，<br />
          <span class="text-neutral-400">快一点。</span>
        </h1>

        <!-- Subheading & Intro -->
        <div class="space-y-3">
          <p class="text-[17px] md:text-[19px] font-semibold text-[#222222] tracking-tight">
            稳定线路 · 全球节点 · 多设备支持
          </p>
          <p class="text-[15px] md:text-[16px] text-[#666666] leading-relaxed max-w-[460px]">
            简单连接，快速开始。适合日常网页、AI 工具、影音娱乐与海外网络使用。
          </p>
        </div>

        <!-- Action CTAs -->
        <div class="pt-2 flex flex-wrap items-center gap-4 sm:gap-6">
          <a 
            href={REGISTER_URL} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="honor-btn-primary px-8 py-4 text-[16px] font-medium shadow-md group"
          >
            <span>立即使用</span>
            <svg class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          <a 
            href="#features" 
            class="honor-btn-secondary text-[16px] font-medium py-3 px-2 flex items-center group text-[#444444] hover:text-[#111111]"
          >
            <span>了解更多</span>
            <span class="ml-1.5 transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </div>

        <!-- Quick Trust Indicators -->
        <div class="pt-4 flex items-center gap-6 border-t border-neutral-100 text-xs text-[#888888]">
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-neutral-600" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>零基础快速上手</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="w-4 h-4 text-neutral-600" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <span>全平台即时适配</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Product Showcase Visual (approx 62% / 7 cols) -->
      <div class="lg:col-span-7 relative flex items-center justify-center lg:justify-end">
        <div class="relative w-full max-w-[660px] aspect-[4/3] sm:aspect-[16/11] bg-gradient-to-b from-[#F9F9FA] to-[#F1F1F4] rounded-3xl p-6 sm:p-10 border border-[#EBEBEF] shadow-premium flex flex-col justify-between overflow-hidden">
          
          <!-- Background Subtle Topology Grid -->
          <div class="absolute inset-0 bg-[radial-gradient(#D5D5DC_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>

          <!-- Top Brand Bar inside Device Mockup -->
          <div class="relative z-10 flex items-center justify-between border-b border-[#E5E5EB]/80 pb-4">
            <div class="flex items-center gap-3">
              <div class="flex gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#E5E5EB]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#E5E5EB]"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#E5E5EB]"></span>
              </div>
              <span class="text-xs font-semibold tracking-wider text-[#777777] uppercase ml-2">网际快车 · 客户端中心</span>
            </div>
            <div class="flex items-center gap-2 bg-white/90 backdrop-blur-md px-3 py-1 rounded-full border border-[#E0E0E6] text-xs font-medium text-[#222222]">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>已连接</span>
            </div>
          </div>

          <!-- Center Showcase: Active Connection Monitor & Node Details -->
          <div class="relative z-10 my-auto py-6 grid grid-cols-1 sm:grid-cols-12 gap-6 items-center">
            
            <!-- Left status card -->
            <div class="sm:col-span-7 bg-white rounded-2xl p-6 border border-[#EAEAEA] shadow-sm space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs text-[#888888] font-medium tracking-wide">当前优选节点</span>
                <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-emerald-50 text-emerald-700 border border-emerald-200/50">高速专线</span>
              </div>

              <div class="flex items-baseline justify-between pt-1">
                <div>
                  <h3 class="text-2xl font-bold text-[#111111] tracking-tight">香港 · HK-01</h3>
                  <p class="text-xs text-[#666666] mt-0.5">亚太核心互联中心</p>
                </div>
                <div class="text-right">
                  <span class="text-2xl font-extrabold text-[#111111] font-mono">42</span>
                  <span class="text-xs text-[#888888] ml-0.5">ms</span>
                </div>
              </div>

              <!-- Minimalist Line Wave -->
              <div class="pt-2">
                <div class="flex items-center justify-between text-[11px] text-[#888888] mb-1.5">
                  <span>实时网络质量</span>
                  <span class="text-emerald-600 font-medium">99.98% 极佳</span>
                </div>
                <div class="h-2 w-full bg-[#F3F3F5] rounded-full overflow-hidden flex gap-1 p-0.5">
                  <div class="h-full bg-emerald-500 rounded-full w-full"></div>
                </div>
              </div>
            </div>

            <!-- Right mini stats -->
            <div class="sm:col-span-5 flex flex-col gap-3">
              <div class="bg-white/85 backdrop-blur-md rounded-xl p-3.5 border border-[#EAEAEA] flex items-center justify-between">
                <div>
                  <p class="text-[11px] text-[#888888]">加密保护</p>
                  <p class="text-xs font-semibold text-[#111111] mt-0.5">端到端传输</p>
                </div>
                <div class="w-7 h-7 rounded-full bg-neutral-100 flex items-center justify-center text-[#111111]">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                  </svg>
                </div>
              </div>

              <div class="bg-white/85 backdrop-blur-md rounded-xl p-3.5 border border-[#EAEAEA] flex items-center justify-between">
                <div>
                  <p class="text-[11px] text-[#888888]">智能分流</p>
                  <p class="text-xs font-semibold text-[#111111] mt-0.5">自动路由加速</p>
                </div>
                <div class="w-7 h-7 rounded-full bg-neutral-100 flex items-center justify-center text-[#111111]">
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
              </div>
            </div>

          </div>

          <!-- Bottom floating region pills -->
          <div class="relative z-10 flex flex-wrap items-center gap-2 pt-2 border-t border-[#E5E5EB]/70">
            <span class="text-[11px] text-[#888888] mr-1">常用节点:</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white rounded-lg text-xs font-medium text-[#222222] border border-[#E2E2E8]">
              <span>🇭🇰 香港</span>
              <span class="text-[10px] text-emerald-600 font-mono">42ms</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white rounded-lg text-xs font-medium text-[#222222] border border-[#E2E2E8]">
              <span>🇯🇵 日本</span>
              <span class="text-[10px] text-emerald-600 font-mono">58ms</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white rounded-lg text-xs font-medium text-[#222222] border border-[#E2E2E8]">
              <span>🇸🇬 新加坡</span>
              <span class="text-[10px] text-emerald-600 font-mono">65ms</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white rounded-lg text-xs font-medium text-[#222222] border border-[#E2E2E8]">
              <span>🇺🇸 美国</span>
              <span class="text-[10px] text-neutral-500 font-mono">120ms</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-white rounded-lg text-xs font-medium text-[#222222] border border-[#E2E2E8]">
              <span>🇹🇼 台湾</span>
              <span class="text-[10px] text-emerald-600 font-mono">48ms</span>
            </span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
