---
const REGISTER_URL = "https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso";
---

<section class="py-16 md:py-24 bg-white">
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 lg:px-16">
    
    <!-- Large Banner Container -->
    <div class="relative bg-[#F5F5F5] rounded-3xl md:rounded-4xl p-8 sm:p-14 lg:p-20 overflow-hidden border border-[#EBEBEF]">
      
      <!-- Ambient light effect -->
      <div class="absolute -right-20 -bottom-20 w-[480px] h-[480px] bg-gradient-to-tl from-neutral-200/50 to-transparent rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center relative z-10">
        
        <!-- Left Banner Content -->
        <div class="lg:col-span-6 space-y-6 text-left">
          <div class="inline-flex items-center gap-2 honor-badge bg-white">
            <span class="w-1.5 h-1.5 rounded-full bg-neutral-900"></span>
            <span>网际快车 旗舰互联</span>
          </div>

          <h2 class="text-[36px] sm:text-[46px] md:text-[56px] font-bold tracking-tight text-[#111111] leading-[1.12]">
            网际快车<br />
            <span class="text-[#555555]">网络不应该复杂。</span>
          </h2>

          <p class="text-[16px] md:text-[18px] text-[#666666] leading-relaxed max-w-[480px]">
            重新定义无感加速体验。告别繁琐设置，打开客户端，一键连通全球网络。
          </p>

          <!-- CTAs -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a 
              href={REGISTER_URL} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="honor-btn-primary px-8 py-3.5 text-[15px] font-medium shadow-md group"
            >
              <span>立即使用</span>
              <svg class="w-4 h-4 ml-2 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
            <a 
              href="#features" 
              class="honor-btn-secondary px-5 py-3.5 text-[15px] font-medium text-[#444444] hover:text-black"
            >
              了解更多
            </a>
          </div>
        </div>

        <!-- Right Banner Visual: High-tech Minimalist Sphere & Nodes -->
        <div class="lg:col-span-6 flex items-center justify-center">
          <div class="w-full max-w-[480px] bg-white rounded-3xl p-8 border border-[#E5E5EB] shadow-subtle flex flex-col justify-between space-y-6">
            <div class="flex items-center justify-between border-b border-neutral-100 pb-4">
              <span class="text-xs font-semibold text-neutral-500 uppercase tracking-wider">全局加速引擎</span>
              <span class="text-xs text-emerald-600 font-medium flex items-center gap-1.5 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                全节点就绪
              </span>
            </div>

            <!-- Visual representation of nodes interconnected -->
            <div class="space-y-3">
              <div class="flex items-center justify-between p-3 rounded-xl bg-[#F9F9FA] border border-[#EEEEF2]">
                <div class="flex items-center gap-3">
                  <span class="text-lg">🇭🇰</span>
                  <div>
                    <p class="text-xs font-bold text-[#111111]">香港 旗舰骨干网</p>
                    <p class="text-[11px] text-neutral-400">亚太超低延迟通道</p>
                  </div>
                </div>
                <span class="text-xs font-mono font-bold text-emerald-600">38 ms</span>
              </div>

              <div class="flex items-center justify-between p-3 rounded-xl bg-[#F9F9FA] border border-[#EEEEF2]">
                <div class="flex items-center gap-3">
                  <span class="text-lg">🇸🇬</span>
                  <div>
                    <p class="text-xs font-bold text-[#111111]">新加坡 AI 专享通道</p>
                    <p class="text-[11px] text-neutral-400">大模型推理极速响应</p>
                  </div>
                </div>
                <span class="text-xs font-mono font-bold text-emerald-600">62 ms</span>
              </div>

              <div class="flex items-center justify-between p-3 rounded-xl bg-[#F9F9FA] border border-[#EEEEF2]">
                <div class="flex items-center gap-3">
                  <span class="text-lg">🇯🇵</span>
                  <div>
                    <p class="text-xs font-bold text-[#111111]">东京 4K 影音骨干</p>
                    <p class="text-[11px] text-neutral-400">多媒体流量智能加速</p>
                  </div>
                </div>
                <span class="text-xs font-mono font-bold text-emerald-600">55 ms</span>
              </div>
            </div>

            <div class="pt-2 text-center">
              <span class="text-[11px] text-neutral-400">端到端数据传输加密 · 隐私零日志保留</span>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
