---
const features = [
  {
    num: '01',
    title: '全球节点',
    desc: '香港、台湾、日本、新加坡、美国等常用地区，根据实际需求选择合适线路。',
    visual: 'globe',
  },
  {
    num: '02',
    title: '多端使用',
    desc: '支持常见桌面与移动设备，满足电脑、手机、平板等使用场景。',
    visual: 'devices',
  },
  {
    num: '03',
    title: '简单连接',
    desc: '减少复杂设置，帮助普通用户更快完成连接。',
    visual: 'lightning',
  },
];
---

<section id="features" class="py-20 md:py-32 bg-white">
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 lg:px-16">
    
    <!-- Section Header (Apple/HONOR style) -->
    <div class="max-w-3xl mb-16 md:mb-20">
      <div class="honor-badge mb-4">
        核心优势
      </div>
      <h2 class="text-[34px] sm:text-[44px] md:text-[52px] font-bold tracking-tight text-[#111111] leading-[1.15]">
        为日常网络而设计
      </h2>
      <p class="text-[17px] md:text-[19px] text-[#666666] mt-4 leading-relaxed">
        不需要复杂配置，从连接开始，到正常使用，只需要几步。
      </p>
    </div>

    <!-- 3 Large Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      
      <!-- Card 01: 全球节点 -->
      <div class="honor-card p-8 sm:p-10 flex flex-col justify-between min-h-[420px] relative overflow-hidden group">
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-3xl sm:text-4xl font-light text-neutral-300 font-mono">01</span>
            <div class="w-10 h-10 rounded-full bg-white border border-[#E5E5EB] flex items-center justify-center text-[#111111] shadow-2xs group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
          </div>
          <h3 class="text-2xl font-bold text-[#111111] tracking-tight mb-3">
            全球节点
          </h3>
          <p class="text-[15px] text-[#666666] leading-relaxed">
            香港、台湾、日本、新加坡、美国等常用地区，根据实际需求选择合适线路。
          </p>
        </div>

        <!-- Minimalist Graphic representation -->
        <div class="mt-8 pt-6 border-t border-[#EAEAEF] flex items-center justify-between text-xs text-[#777777]">
          <span class="inline-flex items-center gap-1.5 font-medium text-neutral-800">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            亚太 & 欧美优质互联
          </span>
          <span class="text-neutral-400">智能负载</span>
        </div>
      </div>

      <!-- Card 02: 多端使用 -->
      <div class="honor-card p-8 sm:p-10 flex flex-col justify-between min-h-[420px] relative overflow-hidden group">
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-3xl sm:text-4xl font-light text-neutral-300 font-mono">02</span>
            <div class="w-10 h-10 rounded-full bg-white border border-[#E5E5EB] flex items-center justify-center text-[#111111] shadow-2xs group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
          </div>
          <h3 class="text-2xl font-bold text-[#111111] tracking-tight mb-3">
            多端使用
          </h3>
          <p class="text-[15px] text-[#666666] leading-relaxed">
            支持常见桌面与移动设备，满足电脑、手机、平板等使用场景。
          </p>
        </div>

        <!-- Minimalist Graphic representation -->
        <div class="mt-8 pt-6 border-t border-[#EAEAEF] flex items-center justify-between text-xs text-[#777777]">
          <span class="inline-flex items-center gap-1.5 font-medium text-neutral-800">
            <span class="w-2 h-2 rounded-full bg-neutral-900"></span>
            Windows · Mac · iOS · Android
          </span>
          <span class="text-neutral-400">多端同步</span>
        </div>
      </div>

      <!-- Card 03: 简单连接 -->
      <div class="honor-card p-8 sm:p-10 flex flex-col justify-between min-h-[420px] relative overflow-hidden group">
        <div>
          <div class="flex items-center justify-between mb-8">
            <span class="text-3xl sm:text-4xl font-light text-neutral-300 font-mono">03</span>
            <div class="w-10 h-10 rounded-full bg-white border border-[#E5E5EB] flex items-center justify-center text-[#111111] shadow-2xs group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
          </div>
          <h3 class="text-2xl font-bold text-[#111111] tracking-tight mb-3">
            简单连接
          </h3>
          <p class="text-[15px] text-[#666666] leading-relaxed">
            减少复杂设置，帮助普通用户更快完成连接。
          </p>
        </div>

        <!-- Minimalist Graphic representation -->
        <div class="mt-8 pt-6 border-t border-[#EAEAEF] flex items-center justify-between text-xs text-[#777777]">
          <span class="inline-flex items-center gap-1.5 font-medium text-neutral-800">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            一键导入 · 极速开启
          </span>
          <span class="text-neutral-400">新手友好</span>
        </div>
      </div>

    </div>
  </div>
</section>
