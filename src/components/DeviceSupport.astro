---
const REGISTER_URL = "https://yinxingren1.invisibleaff.com/#/register?code=Gcp1CRso";

const devices = [
  {
    name: 'Windows',
    tag: '桌面端',
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-13.051-1.802"/></svg>`,
    desc: '支持 Windows 10 / 11 64位系统',
  },
  {
    name: 'macOS',
    tag: '桌面端',
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 1.01-2.87-.96.04-2.13.65-2.77 1.39-.56.64-1.05 1.7-1.01 2.76 1.08.08 2.16-.53 2.77-1.28z"/></svg>`,
    desc: '完美适配 Apple Silicon M 系列与 Intel 芯片',
  },
  {
    name: 'iOS',
    tag: '移动端',
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>`,
    desc: '支持 iPhone / iPad 设备快速配置',
  },
  {
    name: 'Android',
    tag: '移动端',
    icon: `<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M16.61 15.15c-.41 0-.74-.33-.74-.74 0-.41.33-.74.74-.74.41 0 .74.33.74.74 0 .41-.33.74-.74.74m-9.22 0c-.41 0-.74-.33-.74-.74 0-.41.33-.74.74-.74.41 0 .74.33.74.74 0 .41-.33.74-.74.74m9.67-5.59l1.83-3.17c.1-.18.04-.42-.14-.52-.18-.1-.42-.04-.52.14l-1.86 3.23C14.88 8.56 13.48 8.2 12 8.2s-2.88.36-4.37 1.04L5.77 6.01c-.1-.18-.34-.24-.52-.14-.18.1-.24.34-.14.52l1.83 3.17C4.17 11.08 2.2 13.92 2 17.2h20c-.2-3.28-2.17-6.12-4.94-7.64"/></svg>`,
    desc: '适配各大主流品牌 Android 手机与平板',
  },
  {
    name: 'Clash 系列客户端',
    tag: '常用客户端',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    desc: '支持 Clash Verge / Clash for Windows / Meta',
  },
  {
    name: 'Shadowrocket',
    tag: '常用客户端',
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>`,
    desc: 'iOS 广受欢迎的规则分流代理工具',
  },
];
---

<section id="devices" class="py-20 md:py-32 bg-[#FAFAFC] border-t border-[#EAEAEA]">
  <div class="max-w-[1440px] mx-auto px-6 md:px-12 lg:px-16">
    
    <!-- Title & Subtitle -->
    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-20">
      <div class="honor-badge mb-4">
        跨平台适配
      </div>
      <h2 class="text-[34px] sm:text-[44px] md:text-[50px] font-bold tracking-tight text-[#111111] leading-[1.15]">
        一套服务，<br class="hidden sm:inline" />连接你的常用设备
      </h2>
      <p class="text-[16px] md:text-[18px] text-[#666666] mt-4">
        无论在电脑、手机还是平板，随时保持稳定连接体验。
      </p>
    </div>

    <!-- Devices Showcase Hero Mockup (MacBook + iPhone + iPad) -->
    <div class="max-w-4xl mx-auto bg-white rounded-3xl p-8 sm:p-12 border border-[#E8E8EC] shadow-premium mb-14 text-center">
      <div class="relative py-6 flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-8">
        
        <!-- MacBook Mockup (Left) -->
        <div class="w-full sm:w-[48%] bg-[#F7F7F9] rounded-2xl p-5 border border-[#E5E5EB] text-left">
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-neutral-300"></span>
            <span class="text-xs font-semibold text-neutral-500 ml-2">Mac / PC 桌面端</span>
          </div>
          <div class="bg-white rounded-xl p-4 border border-[#EAEAEF] space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="font-medium text-neutral-800">网际快车 运行中</span>
              <span class="text-emerald-600 font-semibold">● 已连接</span>
            </div>
            <div class="h-1.5 w-full bg-neutral-100 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 w-4/5 rounded-full"></div>
            </div>
            <p class="text-[11px] text-[#888888]">系统代理已配置 · 智能分流开启</p>
          </div>
        </div>

        <!-- iPhone Mockup (Right) -->
        <div class="w-full sm:w-[48%] bg-[#F7F7F9] rounded-2xl p-5 border border-[#E5E5EB] text-left">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-semibold text-neutral-500">iOS / Android 移动端</span>
            <span class="text-xs font-mono text-neutral-400">5G / Wi-Fi</span>
          </div>
          <div class="bg-white rounded-xl p-4 border border-[#EAEAEF] space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="font-medium text-neutral-800">节点连接状态</span>
              <span class="text-emerald-600 font-semibold">● 极佳 (42ms)</span>
            </div>
            <div class="h-1.5 w-full bg-neutral-100 rounded-full overflow-hidden">
              <div class="h-full bg-emerald-500 w-full rounded-full"></div>
            </div>
            <p class="text-[11px] text-[#888888]">后台低功耗保活 · 锁屏无缝重连</p>
          </div>
        </div>

      </div>
      <p class="text-xs text-[#888888] mt-4">
        * 具体兼容性以实际客户端及操作系统版本支持为准。
      </p>
    </div>

    <!-- Client Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {devices.map((device) => (
        <div class="bg-white rounded-2xl p-6 border border-[#EAEAEF] hover:border-neutral-300 hover:shadow-subtle transition-all duration-200 flex items-start gap-4">
          <div class="w-12 h-12 rounded-xl bg-[#F5F5F7] flex items-center justify-center text-[#111111] shrink-0">
            <Fragment set:html={device.icon} />
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between mb-1">
              <h4 class="text-base font-bold text-[#111111]">{device.name}</h4>
              <span class="text-[11px] text-neutral-500 bg-neutral-100 px-2 py-0.5 rounded-full">
                {device.tag}
              </span>
            </div>
            <p class="text-[13px] text-[#666666] leading-relaxed">
              {device.desc}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Button -->
    <div class="text-center mt-12">
      <a 
        href="#steps" 
        class="honor-btn-primary px-8 py-3.5 text-[15px] font-medium shadow-sm inline-flex items-center"
      >
        <span>查看使用方式</span>
        <svg class="w-4 h-4 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
